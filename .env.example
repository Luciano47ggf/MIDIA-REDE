# ─────────────────────────────────────────────────────────────
# Copie este arquivo para ".env.local" e preencha os valores.
# NUNCA envie o .env.local para o GitHub.
# ─────────────────────────────────────────────────────────────

# Supabase → Project Settings → API (ou "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Pode ser a "anon key" (legacy) ou a "publishable key" (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRETA: "service_role key" (legacy) ou "secret key" (sb_secret_...). Só no servidor.
SUPABASE_SERVICE_ROLE_KEY=

# Backblaze B2 → App Keys (bucket PRIVADO; o site usa URLs assinadas para tudo)
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=midia-igreja
# Endpoint S3 do seu bucket, SEM barra no final.
# Backblaze → bucket → "Endpoint". Ex.: https://s3.us-west-004.backblazeb2.com
B2_ENDPOINT=
# Região do endpoint acima (a parte do meio). Ex.: us-west-004
B2_REGION=

# Endereço do site, SEM barra no final.
# Local: http://localhost:3000   Produção: https://midia-igreja.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Segredo usado para assinar o cookie de acesso aos álbuns protegidos por senha.
# Gere um texto aleatório longo (mínimo 32 caracteres).
ALBUM_ACCESS_SECRET=
