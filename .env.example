# ─────────────────────────────────────────────────────────────
# Copie este arquivo para ".env.local" e preencha os valores.
# NUNCA envie o .env.local para o GitHub.
# ─────────────────────────────────────────────────────────────

# Supabase → Project Settings → API (ou "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Pode ser a "anon key" (legacy) ou a "publishable key" (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRETA: "service_role key" (legacy) ou "secret key" (sb_secret_...). Só no servidor.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 → R2 Object Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=midia-igreja
# URL pública do bucket, SEM barra no final.
# Ex.: https://pub-xxxxxxxx.r2.dev  ou  https://midia.suaigreja.com.br
R2_PUBLIC_URL=

# Endereço do site, SEM barra no final.
# Local: http://localhost:3000   Produção: https://midia-igreja.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Segredo usado para assinar o cookie de acesso aos álbuns protegidos por senha.
# Gere um texto aleatório longo (mínimo 32 caracteres).
ALBUM_ACCESS_SECRET=
